index 0000000..39da42d
--- /dev/null
+++ b/doom3/neo/framework/Wolf2009Zip.h
@@ -0,0 +1,36 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Wolfenstein (2009) SP uses the usual ZIP central directory with a distinct
+// end-record signature. Read-only compatibility; original files are untouched.
+#ifndef WOLF2009_ZIP_END_RECORD_H
+#define WOLF2009_ZIP_END_RECORD_H
+
+namespace wolf2009 {
+inline unsigned int ZipLE16(const unsigned char* p) {
+    return static_cast<unsigned int>(p[0]) | (static_cast<unsigned int>(p[1]) << 8);
+}
+inline unsigned long long ZipLE32(const unsigned char* p) {
+    return ZipLE16(p) | (static_cast<unsigned long long>(ZipLE16(p + 2)) << 16);
+}
+// This narrow check applies ONLY to the observed custom end record. Existing
+// standard ZIP/ZIP64 recognition is left to the upstream backends.
+inline bool HasPk4EndSignature(const unsigned char* p, unsigned int available) {
+    return available >= 4 && p[0] == 0x02 && p[1] == 0x0a && p[2] == 0x53 && p[3] == 0x48;
+}
+inline bool IsPk4EndRecord(const unsigned char* p, unsigned int available,
+                          unsigned long long position, unsigned long long fileSize) {
+    if (available < 22 || !HasPk4EndSignature(p, available))
+        return false;
+    const unsigned int count = ZipLE16(p + 10);
+    const unsigned long long centralSize = ZipLE32(p + 12);
+    const unsigned long long centralOffset = ZipLE32(p + 16);
+    if (ZipLE16(p + 4) != 0 || ZipLE16(p + 6) != 0 ||
+        ZipLE16(p + 8) != count || count == 0xffff ||
+        centralSize == 0xffffffffULL || centralOffset == 0xffffffffULL)
+        return false;
+    return position <= fileSize && fileSize - position == 22ULL + ZipLE16(p + 20) &&
+           centralOffset <= position && centralSize == position - centralOffset &&
+           centralSize >= static_cast<unsigned long long>(count) * 46 &&
+           (count != 0 || centralSize == 0);
+}
+}
+#endif
