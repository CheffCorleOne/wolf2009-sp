+}
+bool Wolf2009_PinMount(const char* label, unsigned long long& epoch) {
+    try {
+        std::lock_guard<std::mutex> lock(streamsMutex);
+        Need(mounts.get() != NULL, "stream mounts are not initialized");
+        const auto found = sourceLeases.find(Label(label));
+        Need(found != sourceLeases.end(), "resource mount is absent");
+        Need(found->second.pins != static_cast<std::size_t>(-1), "resource mount pin count exhausted");
+        ++found->second.pins;epoch = found->second.epoch;return true;
+    } catch (const std::exception& error) { Report("pin", error);return false; }
+}
+bool Wolf2009_UnpinMount(const char* label, unsigned long long epoch) {
+    try {
+        std::lock_guard<std::mutex> lock(streamsMutex);
+        Need(mounts.get() != NULL, "stream mounts are not initialized");
+        const auto found = sourceLeases.find(Label(label));
+        Need(found != sourceLeases.end() && found->second.epoch == epoch && found->second.pins != 0,
+             "resource mount lease is absent or stale");
+        --found->second.pins;return true;
+    } catch (const std::exception& error) { Report("unpin", error);return false; }
+}
+bool Wolf2009_MountEpoch(const char* label, unsigned long long& epoch) {
+    try {
+        std::lock_guard<std::mutex> lock(streamsMutex);
+        Need(mounts.get() != NULL, "stream mounts are not initialized");
+        const auto found = sourceLeases.find(Label(label));
+        Need(found != sourceLeases.end(), "resource mount is absent");
+        epoch = found->second.epoch;return true;
+    } catch (const std::exception& error) { Report("epoch", error);return false; }
 }
 void Wolf2009_InitStreams() {
     std::lock_guard<std::mutex> lock(streamsMutex);
