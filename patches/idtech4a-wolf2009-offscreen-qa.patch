 		return true;
 	}
 
-	if (cvarSystem->GetCVarInteger("net_serverDedicated") == 1) {
+	if (cvarSystem->GetCVarInteger("net_serverDedicated") == 1
+#ifdef WOLF2009_RUNTIME_GL_QA
+		&& !wolf2009Pbuffer
+#endif
+	) {
 		common->DPrintf("not opening the display: dedicated server\n");
 		return false;
 	}
