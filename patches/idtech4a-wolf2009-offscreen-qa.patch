@@ -85,6 +85,25 @@ static EGLConfig configs[1];
 static EGLConfig eglConfig = 0;
 static EGLint format = WINDOW_FORMAT_RGBA_8888; // AHARDWAREBUFFER_FORMAT_R8G8B8A8_UNORM;
 
+#ifdef WOLF2009_RUNTIME_GL_QA
+// Explicit headless QA only. Normal Android startup still requires its native
+// window and uses exactly the upstream EGL window-surface path.
+static bool wolf2009Pbuffer = false;
+bool GLimp_Wolf2009EnablePbuffer(int width, int height)
+{
+	if (width < 64 || height < 64 || width > 2048 || height > 2048 ||
+		win || eglContext != EGL_NO_CONTEXT || eglSurface != EGL_NO_SURFACE)
+		return false;
+	screen_width = width;
+	screen_height = height;
+	wolf2009Pbuffer = true;
+	return true;
+}
+#define WOLF2009_EGL_SURFACE_TYPE (wolf2009Pbuffer ? EGL_PBUFFER_BIT : EGL_WINDOW_BIT)
+#else
+#define WOLF2009_EGL_SURFACE_TYPE EGL_WINDOW_BIT
+#endif
+
 #ifdef _IMGUI
 #include "imgui.cpp"
 #endif
