+			EGL_SURFACE_TYPE, WOLF2009_EGL_SURFACE_TYPE,
 			EGL_NONE,
 	};
 
@@ -723,7 +746,7 @@ static bool GLES_Init_prefer(const glimpParms_t &ap)
 				EGL_SAMPLE_BUFFERS, multisamples > 1 ? 1 : 0,
 				EGL_SAMPLES, multisamples,
