diff --git a/doom3/neo/CMakeLists.txt b/doom3/neo/CMakeLists.txt
--- a/doom3/neo/CMakeLists.txt
+++ b/doom3/neo/CMakeLists.txt
@@ -3645,4 +3645,15 @@
 		)
 	endif()
 
 endif()
+
+# The independent bootstrap uses the ordinary GPL Doom3 game ABI and lifecycle.
+# It is opt-in; the application decides when/how to provide its content.
+option(WOLF2009_BOOTSTRAP "Build the bounded headless Wolf2009 runtime host" OFF)
+set(WOLF2009_BOOT_DIR "" CACHE PATH "Directory containing the standalone GPL runtime host")
+if(WOLF2009_BOOTSTRAP)
+	if(NOT EXISTS "${WOLF2009_BOOT_DIR}/CMakeLists.txt")
+		message(FATAL_ERROR "WOLF2009_BOOTSTRAP requires WOLF2009_BOOT_DIR")
+	endif()
+	include("${WOLF2009_BOOT_DIR}/CMakeLists.txt")
+endif()

