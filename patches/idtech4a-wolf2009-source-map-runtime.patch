+		// Independently generated source-collision response declarations retain
+		// the original uint32 word. This is a native mask profile, not the
+		// original runtime eligibility/userData filter or material shader.
+#ifdef WOLF2009_GAMEPLAY
+		else if (!token.Icmp("wolf2009SourceContents")) {
+			if (idStr::Cmpn(GetName(), "wolf2009/collision/source-word-v1/", 34) != 0 ||
+			    !src.ReadToken(&token) || token.Length() != 8) {
+				src.Warning("invalid generated source contents declaration");
+				SetMaterialFlag(MF_DEFAULTED); return;
+			}
+			unsigned value = 0;
+			for (int c = 0; c < 8; ++c) {
+				const char digit = token[c];
+				if (!((digit >= '0' && digit <= '9') || (digit >= 'a' && digit <= 'f'))) { SetMaterialFlag(MF_DEFAULTED); return; }
+				value = (value << 4) | (digit <= '9' ? digit - '0' : digit - 'a' + 10);
+			}
+			if (!value || (value & ~0x03ffffffu) || idStr::Cmp(GetName() + 34, token.c_str()) != 0) { SetMaterialFlag(MF_DEFAULTED); return; }
+			contentFlags = static_cast<int>(value);
+			continue;
+		}
+#endif
 		// translucent
 		else if (!token.Icmp("translucent")) {
 			coverage = MC_TRANSLUCENT;
