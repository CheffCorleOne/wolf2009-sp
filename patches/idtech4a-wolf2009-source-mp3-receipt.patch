+#ifdef WOLF2009_SOURCE_MP3_RECEIPT
+void idSampleDecoderLocal::ClearSourceMp3Receipt() {
+    // Unlike ClearDecoder, this must not take CRITICAL_SECTION_ONE again.
+    // This decoder is private to the receipt; do not change ordinary cleanup.
+    if (mp3) { mp3dec_ex_close(mp3); Mem_Free(mp3); mp3 = NULL; }
+    Clear();
+}
+
+WolfSourceMp3NativeCounts Wolf2009_InspectSourceMp3BytesLocked(
+    const idSoundSample& sample, std::uint64_t maximumSamples) {
+    struct Frames {
+        mp3dec_t decoder;
+        Frames() { mp3dec_init(&decoder); }
+        wolfSourceMp3Strict::Frame operator()(const unsigned char* data, int size) {
+            mp3dec_frame_info_t info = {};
+            wolfSourceMp3Strict::Frame out;
+            out.samples = mp3dec_decode_frame(&decoder, data, size, NULL, &info);
+            out.bytes = info.frame_bytes; out.rate = info.hz;
+            out.channels = info.channels; out.layer = info.layer;
+            return out;
+        }
+    } frames;
+    const auto coverage = wolfSourceMp3Strict::Framing(sample.nonCacheData,
+        std::size_t(sample.objectMemSize), maximumSamples, frames);
+    struct Decoder {
+        idSampleDecoderLocal value;
+        Decoder() { value.Clear(); }
+        ~Decoder() { value.ClearSourceMp3Receipt(); }
+    } decoder;
+    struct Reads {
+        idSampleDecoderLocal& decoder;
+        idSoundSample* sample;
+        Reads(idSampleDecoderLocal& d, const idSoundSample& s):decoder(d),sample(const_cast<idSoundSample*>(&s)){}
+        wolfSourceMp3Strict::Read operator()(int offset, int count, float* output) {
+            WolfSourceMp3ReadAccounting result;
+            result.actual = decoder.DecodeMP3(sample, offset, count, output, &result);
+            return result;
+        }
+    } reads(decoder.value, sample);
+    const auto pcm = wolfSourceMp3Strict::DecodeAll(coverage.samples, maximumSamples, reads);
+    WolfSourceMp3NativeCounts out;
+    out.frames = coverage.frames; out.samples = pcm.actual;
+    return out;
+}
+#endif
