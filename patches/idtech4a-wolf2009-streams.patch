+// SPDX-License-Identifier: GPL-3.0-or-later
+#ifndef WOLF2009_ENGINE_STREAMS_H
+#define WOLF2009_ENGINE_STREAMS_H
+class idFile;
+// C++98-compatible boundary: no idFileSystem ABI or ordinary path changes.
+bool Wolf2009_IsResourcePath(const char* path);
+idFile* Wolf2009_OpenResource(const char* path);
+bool Wolf2009_Mount(const char* label, const char* archiveRelativePath);
+bool Wolf2009_Unmount(const char* label);
+void Wolf2009_InitStreams();
+void Wolf2009_ShutdownStreams();
+#endif
