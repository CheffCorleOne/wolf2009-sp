+// Both callers preflight before Reset/PushAnims can replace a live channel.
+// Native SetFrame is one-based; source ENTS frame semantics are not inferred.
+static bool Wolf2009_SourceFixedFrameAllowed(const idDeclModelDef *modelDef, int animNum, int frame, int currentTime, int blendTime) {
+	if (!modelDef || animNum < 1 || animNum > SHRT_MAX || currentTime < 0 || blendTime < 0 || currentTime > INT_MAX - blendTime) return false;
+	const idAnim *anim = modelDef->GetAnim(animNum);
+	if (!anim || anim->NumAnims() != 1 || anim->HasFrameCommands()) return false;
+	const idMD5Anim *source = anim->MD5Anim(0);
+	if (!source || !source->IsSourceAnimationV2() || !source->SourceMatchesModel(modelDef->ModelHandle()) ||
+	    source->NumJoints() < 1 || modelDef->NumJoints() != source->NumJoints() || frame < 1 || frame > source->NumFrames()) return false;
+	const animFlags_t &flags = anim->GetAnimFlags();
+	return !flags.prevent_idle_override && !flags.random_cycle_start && !flags.ai_no_turn && !flags.anim_turn;
+}
 #endif
 
