+bool Wolf2009_MountInventory(const char* label, unsigned long long& epoch,
+                             unsigned long long& resources, unsigned long long& chunks) {
+    try {
+        std::lock_guard<std::mutex> lock(streamsMutex);
+        Need(mounts.get() != NULL, "stream mounts are not initialized");
+        const std::string id = Label(label);
+        const auto found = sourceLeases.find(id);
+        Need(found != sourceLeases.end(), "resource mount is absent");
+        for (const auto& m : mounts->Mounts()) {
+            if (m.id != id) continue;
+            epoch = found->second.epoch;resources = m.resources;chunks = m.chunks;return true;
+        }
+        throw std::runtime_error("resource mount inventory is absent");
+    } catch (const std::exception& error) { Report("inventory", error);return false; }
+}
