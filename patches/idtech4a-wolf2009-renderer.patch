@@ -3,6 +3,8 @@ cmake_minimum_required(VERSION 2.8.12...3.5 FATAL_ERROR) # 2.6
 project(doom3)
 option(WOLF2009_STREAMS "Enable explicit read-only Wolf2009 typed-resource mounts in Doom3 core" OFF)
 set(WOLF2009_CORE_DIR "" CACHE PATH "Directory containing Wolf2009 Archive.cpp and StreamMounts.cpp")
+option(WOLF2009_RENDERER "Enable original Wolf2009 static geometry and diffuse images in the native renderer" OFF)
+set(WOLF2009_RENDER_DIR "" CACHE PATH "Directory containing Wolf2009Render.cpp and RenderData.cpp")
 
 set(IDTECH4AMM_ENGINE_PATCH 73)
 set(IDTECH4AMM_ENGINE_VERSION "1.1.0harmattan${IDTECH4AMM_ENGINE_PATCH}")
@@ -2173,6 +2175,26 @@ if(CORE)
 		target_link_libraries(${DOOM3BINARY} wolf2009_stream_bridge)
 	endif()
 
+	if(WOLF2009_RENDERER)
+		if(NOT WOLF2009_STREAMS OR NOT EXISTS "${WOLF2009_RENDER_DIR}/Wolf2009Render.cpp")
+			message(FATAL_ERROR "WOLF2009_RENDERER requires WOLF2009_STREAMS and WOLF2009_RENDER_DIR")
+		endif()
+		add_library(wolf2009_render_bridge STATIC
+			"${WOLF2009_RENDER_DIR}/Wolf2009Render.cpp" "${WOLF2009_RENDER_DIR}/RenderData.cpp"
+			"${WOLF2009_CORE_DIR}/Geometry.cpp" "${WOLF2009_CORE_DIR}/Material.cpp"
+			"${WOLF2009_CORE_DIR}/Dds.cpp" "${WOLF2009_CORE_DIR}/ZipArchive.cpp")
+		set_target_properties(wolf2009_render_bridge PROPERTIES CXX_STANDARD 11 CXX_STANDARD_REQUIRED ON
+			POSITION_INDEPENDENT_CODE ON COMPILE_DEFINITIONS "${CORE_DEFINES}")
+		target_include_directories(wolf2009_render_bridge PRIVATE "${WOLF2009_CORE_DIR}" "${WOLF2009_RENDER_DIR}"
+			"${CMAKE_CURRENT_SOURCE_DIR}" "${CMAKE_CURRENT_SOURCE_DIR}/idlib"
+			"${CMAKE_CURRENT_SOURCE_DIR}/externlibs" "${CMAKE_CURRENT_SOURCE_DIR}/externlibs/miniz")
+		if(USE_MINIZ)
+			set_property(TARGET wolf2009_render_bridge APPEND PROPERTY COMPILE_DEFINITIONS WOLF2009_USE_MINIZ)
+		endif()
+		set_property(TARGET ${DOOM3BINARY} APPEND PROPERTY COMPILE_DEFINITIONS WOLF2009_RENDERER)
+		target_include_directories(${DOOM3BINARY} PRIVATE "${WOLF2009_RENDER_DIR}")
+		target_link_libraries(${DOOM3BINARY} wolf2009_render_bridge)
+	endif()
 	target_link_libraries(${DOOM3BINARY}
 		idlib
 		${sys_libs}
