diff --git a/doom3/neo/CMakeLists.txt b/doom3/neo/CMakeLists.txt
index 9529c23..f363097 100644
--- a/doom3/neo/CMakeLists.txt
+++ b/doom3/neo/CMakeLists.txt
@@ -3730,3 +3730,13 @@ if(WOLF2009_RENDERER OR WOLF2009_ANIMATION OR WOLF2009_ANIMATION_QA)
 	endif()
 	include("${WOLF2009_RENDER_DIR}/../idtech4a_anim/EngineAnimation.cmake")
 endif()
+
+# Wolf2009 DewmAAS 1.40 conversion for the ordinary idAASFileManager (profile WolfAas140V1).
+option(WOLF2009_AAS140 "Convert Wolf2009 AASS navigation for the GPL Doom3 AAS" OFF)
+set(WOLF2009_AAS_DIR "" CACHE PATH "Directory containing EngineAas140.cmake")
+if(WOLF2009_AAS140)
+	if(NOT EXISTS "${WOLF2009_AAS_DIR}/EngineAas140.cmake")
+		message(FATAL_ERROR "WOLF2009_AAS140 requires WOLF2009_AAS_DIR")
+	endif()
+	include("${WOLF2009_AAS_DIR}/EngineAas140.cmake")
+endif()
diff --git a/doom3/neo/tools/compilers/aas/AASFileManager.cpp b/doom3/neo/tools/compilers/aas/AASFileManager.cpp
