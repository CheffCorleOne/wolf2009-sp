--- a/doom3/neo/tools/compilers/aas/AASFileManager.cpp
+++ b/doom3/neo/tools/compilers/aas/AASFileManager.cpp
@@ -32,6 +32,14 @@ If you have questions concerning this license or the applicable additional terms
 #include "AASFile.h"
 #include "AASFile_local.h"
 
+#ifdef WOLF2009_AAS140
+// Wolf2009 AASS conversion (profile WolfAas140V1, src/idtech4a_aas). Reserved
+// wolf2009/<label>/PROC/<map>.aas28 requests never reach the Doom 3 loader.
+bool Wolf2009_IsAas140Request(const char *fileName);
+idAASFile *Wolf2009_LoadAas140(const char *fileName, unsigned int mapFileCRC);
+void Wolf2009_ReleaseAas140(idAASFile *file);
+#endif
+
 /*
 ===============================================================================
 
@@ -60,6 +68,11 @@ idAASFileManagerLocal::LoadAAS
 */
 idAASFile *idAASFileManagerLocal::LoadAAS(const char *fileName, unsigned int mapFileCRC)
 {
+#ifdef WOLF2009_AAS140
+	if (Wolf2009_IsAas140Request(fileName)) {
+		return Wolf2009_LoadAas140(fileName, mapFileCRC);
+	}
+#endif
 	idAASFileLocal *file = new idAASFileLocal();
 
 	if (!file->Load(fileName, mapFileCRC)) {
@@ -77,5 +90,8 @@ idAASFileManagerLocal::FreeAAS
 */
 void idAASFileManagerLocal::FreeAAS(idAASFile *file)
 {
+#ifdef WOLF2009_AAS140
+	Wolf2009_ReleaseAas140(file);
+#endif
 	delete file;
 }
