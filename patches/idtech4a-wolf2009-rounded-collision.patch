@@ -77,5 +77,38 @@
 	idCollisionModelManagerLocal::getContacts = false;
 	idCollisionModelManagerLocal::maxContacts = 0;
 
+#ifdef WOLF2009_ROUNDED_CM
+	// Query after leaving native collection. Even a full native output array
+	// must not hide an uncertain rounded candidate, so capacity zero still runs.
+	const int nativeCount = idCollisionModelManagerLocal::numContacts;
+	idBounds roundedBounds;
+	int roundedContents;
+	const WolfCMStatus metadata = Wolf2009_CMMetadata(model, roundedBounds, roundedContents);
+	Wolf2009_CheckCMStatus(metadata, "Contacts metadata");
+	if (metadata != WolfCM_NoSidecar) {
+		if (maxContacts < 0 || maxContacts > 4096 || nativeCount < 0 || nativeCount > maxContacts ||
+		    (maxContacts > 0 && contacts == NULL)) {
+			common->Error("Wolf2009 rounded CM Contacts: invalid output capacity");
+		}
+		const int capacity = maxContacts - nativeCount;
+		idList<trace_t> rounded;
+		rounded.SetNum(capacity);
+		int roundedCount = 0;
+		const WolfCMQuery query = Wolf2009_MakeCMQuery(model, trm, trmAxis, contentMask, origin, modelAxis);
+		const WolfCMStatus status = Wolf2009_CMContacts(capacity ? rounded.Ptr() : NULL, capacity, roundedCount,
+		                                                start, dir, depth, query);
+		Wolf2009_CheckCMStatus(status, "Contacts");
+		if (status == WolfCM_Complete) {
+			if (roundedCount < 0 || roundedCount > capacity) {
+				common->Error("Wolf2009 rounded CM Contacts: invalid result count");
+			}
+			for (int i = 0; i < roundedCount; ++i) {
+				contacts[nativeCount + i] = rounded[i].c;
+			}
+			idCollisionModelManagerLocal::numContacts = nativeCount + roundedCount;
+		}
+	}
+#endif
+
 	return idCollisionModelManagerLocal::numContacts;
 }
