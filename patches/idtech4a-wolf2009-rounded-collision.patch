+// C++98 bridge for the BASE integer-handle CM. The sidecar never replaces an
+// indeterminate query with a native-only miss. Call outside contact collection.
+static ID_INLINE void Wolf2009_CheckCMStatus(WolfCMStatus status, const char *operation) {
+	if (status != WolfCM_NoSidecar && status != WolfCM_Complete) {
+		common->Error("Wolf2009 rounded CM %s failed (%d): %s", operation, (int)status,
+		              Wolf2009_CMLastDiagnostic());
+	}
+}
+static ID_INLINE WolfCMQuery Wolf2009_MakeCMQuery(cmHandle_t handle,
+                const idTraceModel *trm, const idMat3 &trmAxis, int contentMask,
+                const idVec3 &modelOrigin, const idMat3 &modelAxis) {
+	WolfCMQuery query;
+	query.handle = handle;
+	query.trm = trm;
+	query.trmAxis = &trmAxis;
+	query.contentMask = contentMask;
+	query.modelOrigin = &modelOrigin;
+	query.modelAxis = &modelAxis;
+	query.clipEpsilon = CM_CLIP_EPSILON;
+	return query;
+}
+#ifdef _DEBUG
+// Native debug retraces must not diagnose a sidecar surface before its public
+// wrapper merges that surface. Failures still reach the actual query wrapper.
+static ID_INLINE bool Wolf2009_CMSidecarDebugDisabled(cmHandle_t handle) {
+	idBounds bounds;
+	int contents;
+	return Wolf2009_CMMetadata(handle, bounds, contents) != WolfCM_NoSidecar;
+}
+#endif
+#endif
 
