@@ -588,7 +588,37 @@
 idCollisionModelManagerLocal::ContentsTrm
 ==================
 */
+#ifdef WOLF2009_ROUNDED_CM
 int idCollisionModelManagerLocal::ContentsTrm(trace_t *results, const idVec3 &start,
+                const idTraceModel *trm, const idMat3 &trmAxis, int contentMask,
+                cmHandle_t model, const idVec3 &modelOrigin, const idMat3 &modelAxis)
+{
+	const int nativeContents = ContentsTrmNative(results, start, trm, trmAxis, contentMask, model, modelOrigin, modelAxis);
+	if (getContacts) {
+		return nativeContents;
+	}
+	const WolfCMQuery query = Wolf2009_MakeCMQuery(model, trm, trmAxis, contentMask, modelOrigin, modelAxis);
+	trace_t rounded;
+	const WolfCMStatus status = Wolf2009_CMPosition(rounded, start, query);
+	Wolf2009_CheckCMStatus(status, "ContentsTrm");
+	if (status == WolfCM_NoSidecar) {
+		return nativeContents;
+	}
+	const int combined = nativeContents | rounded.c.contents;
+	if (rounded.c.contents != 0) {
+		// Both contacts, if present, are at fraction zero. Use the complete
+		// rounded witness rather than a native fast-point test's partial trace.
+		*results = rounded;
+	}
+	results->c.contents = combined;
+	results->fraction = (combined == 0);
+	return combined;
+}
+
+int idCollisionModelManagerLocal::ContentsTrmNative(trace_t *results, const idVec3 &start,
